# Only needed for LiveKit/cloud or the original cloud voice modes.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OPENAI_API_KEY=
CARTESIA_API_KEY=
GOOGLE_API_KEY=

# Set to ollama for local reasoning; openai-cartesia keeps the original mode.
AGENT_DESIGN=ollama
OLLAMA_BASE_URL=http://140.124.73.136:11434/v1
OLLAMA_MODEL=qwen3-vl:4b
VOICE_BACKEND=local
# Local English speech models; no speech-provider API keys are needed.
LOCAL_STT_MODEL=tiny.en
LOCAL_STT_LANGUAGE=en
LOCAL_TTS_MODEL=models/en_US-lessac-low.onnx

# Keep the default so voice commands go through cmd_vel_mux.
PUPSTER_CMD_VEL_TOPIC=/llm_cmd_vel
